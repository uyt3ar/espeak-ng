<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/dictionary_selector"
        android:text="@string/dictionary_select_label" />

    <Spinner
        android:id="@+id/dictionary_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/import_dictionary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dictionary_import_button" />

    <TextView
        android:id="@+id/dictionary_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/dictionary_editor_help" />

    <EditText
        android:id="@+id/dictionary_source"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="start|top"
        android:hint="@string/dictionary_editor_hint"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:typeface="monospace" />

    <Button
        android:id="@+id/save_dictionary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dictionary_save_compile_button" />

</LinearLayout>
